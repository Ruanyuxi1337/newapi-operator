# newapi-operator configuration.
# Copy to .env (or export these) before running the server.

# --- required ---
# Your New API origin. Call the container/gateway port directly, not a public
# domain: reverse proxies that normalise trailing slashes answer 307 and drop
# the request body, which breaks every create/update call.
NEWAPI_BASE_URL=http://127.0.0.1:3000

# Admin access token: New API panel -> avatar -> 个人设置 -> 生成访问令牌.
# Not a relay key (sk-...), and not your password: New API allows one session
# per user, so a scripted password login while a browser is open returns 409.
NEWAPI_ACCESS_TOKEN=

# Numeric id of the token owner. Sent as the New-Api-User header.
NEWAPI_USER_ID=1

# --- optional ---
# Per-request timeout.
# NEWAPI_TIMEOUT=60s

# Refuse every mutating tool. Recommended for an agent that should only observe.
# NEWAPI_READ_ONLY=false

# Quota units per currency unit. New API ships 500000 (= 500000 quota per $1).
# Used to convert the *_usd arguments on token_create / user_manage.
# NEWAPI_QUOTA_PER_UNIT=500000

# --- transport ---
# stdio (default) or http.
# MCP_TRANSPORT=stdio
# Required when MCP_TRANSPORT=http; the /mcp endpoint rejects anything else.
# MCP_HTTP_ADDR=127.0.0.1:8080
# MCP_HTTP_TOKEN=

# --- logging ---
# debug | info | warn | error
# LOG_LEVEL=info
# text | json
# LOG_FORMAT=text